{
  "name": "@dkukushkin/3d-pano",
  "version": "0.0.0",
  "description": "Framework-agnostic WebGL2 panorama and virtual tour engine: cube, equirectangular and multiresolution panoramas, hotspots, scene transitions, 3D tours and VR, with a React adapter.",
  "keywords": [
    "360",
    "cubemap",
    "equirectangular",
    "panorama",
    "react",
    "virtual-tour",
    "webgl2",
    "webxr"
  ],
  "homepage": "https://github.com/DKukushkin91/3d-pano#readme",
  "bugs": "https://github.com/DKukushkin91/3d-pano/issues",
  "license": "MIT",
  "author": "Dmitrii Kukushkin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DKukushkin91/3d-pano.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:comments": "node scripts/check-comments.mjs",
    "check:clean-room": "node scripts/check-clean-room.mjs",
    "check:specs": "openspec validate --all --strict --no-interactive",
    "test:unit": "node --test scripts/*.unit.mjs",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check": "pnpm format:check && pnpm build && pnpm lint && pnpm check:comments && pnpm check:clean-room && pnpm check:specs && pnpm typecheck && pnpm test:unit && pnpm check:package && pnpm check:examples && pnpm check:docs",
    "dev": "pnpm --filter ./examples/playground dev",
    "prepack": "pnpm build",
    "check:examples": "pnpm --filter ./examples/playground typecheck && pnpm --filter ./examples/playground build",
    "check:docs": "node scripts/check-doc-examples.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@fission-ai/openspec": "1.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "oxc-parser": "^0.149.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.3"
}
